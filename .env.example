# .env.example
# ------------
# Copy this file to `.env` and fill in your real values.
# The .env file is gitignored — never commit it.
#
# Gmail setup guide:
#   1. Enable 2-Factor Authentication on your Google account.
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create a new App Password (name it "Job Tracker" or anything).
#   4. Copy the 16-character password — paste it as SMTP_PASSWORD below.
#   5. SMTP_USER is your Gmail address (e.g. yourname@gmail.com).
#   6. EMAIL_RECIPIENT is who receives the alerts (can be your own address).

# ── Required ──────────────────────────────────────────────────────
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=your_email@example.com

# ── Optional (defaults work fine for Gmail) ───────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
